rules_version = '2';
// Royal Garden Water Billing — Firestore security rules
// Paste this whole file into: Firebase console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasRole() { return signedIn() && exists(userPath()); }
    function me() { return get(userPath()).data; }
    function isAdmin() { return hasRole() && me().role == 'admin'; }
    function isReader() { return hasRole() && me().role == 'reader'; }
    function isResident() { return hasRole() && me().role == 'resident'; }
    function myHid() { return me().hid; }
    function isStaff() { return hasRole() && me().role == 'staff'; }
    // Complaints staff rights, set by the admin in Settings (settings/main.staffRights)
    function sr(k, d) { return get(/databases/$(database)/documents/settings/main).data.get('staffRights', {}).get(k, d); }
    function staffTopicOk(t) {
      return sr('inbox', true) && (t == 'complaint'
        || (t == 'payment' && sr('payments', false))
        || (t == 'message' && sr('messages', false)));
    }
    function setupPath() { return /databases/$(database)/documents/meta/setup; }
    // true only inside the one-time "create first admin" batch
    function bootstrapping() { return signedIn() && !exists(setupPath()) && existsAfter(setupPath()); }

    // One-time setup marker. Created together with the first admin; never changed.
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn() && !exists(setupPath())
        && getAfter(userPath()).data.role == 'admin';
    }

    // Role of each login: admin / reader / resident (+ the plot it belongs to)
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (bootstrapping() && request.auth.uid == uid && request.resource.data.role == 'admin');
      allow update, delete: if isAdmin();
    }

    // username -> internal login email (needed before sign-in, holds nothing private)
    match /logins/{username} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() || bootstrapping();
    }

    match /settings/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }

    // Admin-only private config (e.g. the email script link and its secret key)
    match /private/{id} {
      allow read, write: if isAdmin();
    }

    // Plots: residents can only read their own plot
    match /houses/{hid} {
      allow read: if isAdmin() || isReader() || (isStaff() && sr('inbox', true)) || (isResident() && myHid() == hid);
      allow write: if isAdmin();
    }

    // Meter readings: admin + meter readers only
    // Meter readings. Readers can only ADD a plot's reading; once entered, only the admin can correct or delete it.
    match /readings/{month} {
      allow read: if isAdmin() || isReader();
      allow create: if isAdmin() || isReader();
      allow update: if isAdmin()
        || (isReader()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r', 'month'])
          && request.resource.data.month == resource.data.month
          && request.resource.data.r.diff(resource.data.r).changedKeys().size() == 0
          && request.resource.data.r.diff(resource.data.r).removedKeys().size() == 0);
      allow delete: if isAdmin();
    }

    // Meter problems the reader notes while taking readings (leaks, broken meters).
    // Readers can add notes and mark them repaired; only the admin can reopen or delete.
    match /meterIssues/{id} {
      allow read: if isAdmin() || isReader();
      allow create: if isAdmin()
        || (isReader()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'open');
      allow update: if isAdmin()
        || (isReader()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'fixedAt', 'fixedBy'])
          && request.resource.data.status == 'fixed');
      allow delete: if isAdmin();
    }

    // Bill run info (month, due date) — no personal data
    match /billRuns/{month} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }

    // One document per plot per month. Residents can only read their own.
    match /bills/{id} {
      allow read: if isAdmin() || (isResident() && resource.data.hid == myHid());
      allow write: if isAdmin();
    }

    // Payment proofs sent by residents; only the admin can approve/reject
    match /proofs/{id} {
      allow read: if isAdmin() || (isResident() && resource.data.hid == myHid());
      allow create: if isResident()
        && request.resource.data.hid == myHid()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Inbox: complaints, messages and payment screenshots between a plot and the office.
    // topic = complaint / payment / message. Residents only see and write their own plot's messages.
    // Complaints staff only see the topics the admin allows (complaints always, payments / general messages if ticked).
    match /messages/{id} {
      allow read: if isAdmin()
        || (isResident() && resource.data.hid == myHid())
        || (isStaff() && staffTopicOk(resource.data.topic));
      allow create: if (isAdmin() && request.resource.data.from == 'admin')
        || (isStaff() && sr('reply', true)
          && request.resource.data.from == 'admin'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind == 'message'
          && request.resource.data.seenByResident == false
          && !('proofId' in request.resource.data)
          && staffTopicOk(request.resource.data.topic))
        || (isResident()
          && request.resource.data.hid == myHid()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.from == 'resident'
          && request.resource.data.seenByAdmin == false
          && request.resource.data.kind in ['complaint', 'payment', 'message']
          && request.resource.data.topic == request.resource.data.kind
          && (!('status' in request.resource.data) || request.resource.data.status == 'open'));
      allow update: if isAdmin()
        || (isStaff() && staffTopicOk(resource.data.topic)
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByAdmin'])
            || (sr('resolve', true) && resource.data.topic == 'complaint'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'seenByAdmin', 'resolvedAt', 'resolvedBy', 'reopenedAt']))))
        || (isResident() && resource.data.hid == myHid() && resource.data.from == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByResident']));
      allow delete: if isAdmin();
    }
  }
}
